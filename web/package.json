{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-ort.mjs",
    "dev": "node scripts/copy-ort.mjs && node scripts/build-worker.mjs && next dev",
    "build": "node scripts/copy-ort.mjs && node scripts/build-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:build": "NEXT_PUBLIC_API_URL=http://localhost:4310 npm run build",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@edunazorat/shared": "*",
    "fflate": "^0.8.3",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "onnxruntime-web": "^1.30.0",
    "pdfjs-dist": "6.3.289",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "22.x"
  }
}

# ---- EduNazorat API sozlamalari ----
# production: haqiqiy o'quvchilar. Xavfli sozlama (demo, SMS sinov rejimi, http, pglite) bo'lsa server ishga tushmaydi.
# Bo'sh: sinov/pilot serveri (faqat ogohlantirish). SECURITY.md ga qarang.
APP_ENV=
PORT=4000
# Server oldida nechta proksi bor (nginx, Render: 1; to'g'ridan-to'g'ri internetga ochiq bo'lsa: 0)
TRUST_PROXY=1
# true: refresh token httpOnly cookie'da (production'da majburiy). Sayt va API bitta domen ostida bo'lsin:
# app.maktab.uz va api.maktab.uz. Turli domenlar (Vercel + Render pilot) uchun false.
AUTH_COOKIE=false
# Rahbariyat (direktor, administrator, super admin) uchun 2FA majburiy. production'da standart: true
# REQUIRE_STAFF_2FA=true
# 2FA kalitlarini shifrlash (32 bayt, base64): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Yo'qotmang va JWT_SECRET dan alohida saqlang
MFA_KEY=

# Ma'lumotlar bazasi:
#   Neon (bulut):        postgres://user:parol@ep-xxx.neon.tech/neondb?sslmode=require
#   Lokal Postgres:      postgres://postgres:parol@localhost:5432/edunazorat
#   Postgres o'rnatmasdan (maktab kompyuteri, sinov): pglite:./data/db
DATABASE_URL=pglite:./data/db

# Kamida 32 belgili tasodifiy satr: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Web ilova manzili (vergul bilan bir nechta) va API ning tashqi manzili
WEB_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:4000

# SMS (Eskiz.uz). Bo'sh bo'lsa SMS_DEV_MODE yoqiladi: kod ekranda ko'rinadi (faqat sinov!)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# SMS_DEV_MODE=true

# true: bo'sh bazaga demo ma'lumotlar yoziladi
SEED_DEMO=false

# Web Push (brauzer yopiq bo'lsa ham bildirishnoma): npm run vapid -w api
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@maktab.uz

# Onlayn to'lov (shartnoma tuzilgach). Kalitlar faqat serverda saqlanadi.
# Click: Prepare URL = PUBLIC_URL/payments/click/prepare, Complete URL = PUBLIC_URL/payments/click/complete
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# Payme: Endpoint URL = PUBLIC_URL/payments/payme
PAYME_KEY=
PAYME_TEST_KEY=

# Z_AMS (maktab kameralari dasturi) ulanishi. Ikkalasi berilsa yoqiladi: Z_AMS admin panelida ruxsat
# berilgan maktabgina ulana oladi. ZAMS_SERVICE_KEY = Z_AMS serveridagi AMS_EDU_SERVICE_KEY.
ZAMS_VERIFY_URL=
ZAMS_SERVICE_KEY=
